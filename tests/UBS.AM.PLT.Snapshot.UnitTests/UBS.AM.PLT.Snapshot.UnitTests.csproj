<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The API exception handlers under test use ASP.NET Core types (IExceptionHandler,
       IProblemDetailsService, DefaultHttpContext), so this test project needs the AspNetCore
       shared framework in addition to referencing the Api project. The shared framework also
       supplies Microsoft.Extensions.Configuration/DependencyInjection/Hosting/Logging, so
       those are no longer listed as explicit PackageReferences (NU1510). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\UBS.AM.PLT.Snapshot.Domain\UBS.AM.PLT.Snapshot.Domain.csproj" />
    <ProjectReference Include="..\..\src\Core\UBS.AM.PLT.Snapshot.Application\UBS.AM.PLT.Snapshot.Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Sql\UBS.AM.PLT.Snapshot.Infrastructure.Sql.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Adls\UBS.AM.PLT.Snapshot.Infrastructure.Adls.csproj" />
    <ProjectReference Include="..\..\src\Clients\UBS.AM.PLT.Snapshot.Api\UBS.AM.PLT.Snapshot.Api.csproj" />
    <ProjectReference Include="..\..\src\Clients\UBS.AM.PLT.Snapshot.Worker\UBS.AM.PLT.Snapshot.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JunitXml.TestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
