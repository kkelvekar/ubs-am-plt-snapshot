{
  "Kafka": {
    "Topic": "ubs-advantage-snapshots",
    "ConsumerGroup": "snapshot-writer-api",
    "BootstrapServers": "localhost:9092",
    "RetryDelays": [ "00:00:00", "00:00:05", "00:00:30" ],
    "AlertRepeatEveryFailures": 10
  },
  "BlobStorage": {
    "ServiceUri": "https://ubsplatformdevdata.blob.core.windows.net",
    "ConnectionString": "",
    "ContainerName": "ubsadvsnapshots"
  },
  "Database": {
    "ConnectionString": "Server=tcp:sql-kk-tier1-dev-uksouth.database.windows.net,1433;Database=platform-core-db-dev;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False"
  },
  "SnapshotConfig": {
    "portfolio": {
      "requiredFiles": [
        "header.json",
        "instruments.json",
        "calculations.json",
        "settings.json"
      ]
    }
  },
  "IntegrationTestSettings": {
    "CleanupAfterTest": true
  }
}
