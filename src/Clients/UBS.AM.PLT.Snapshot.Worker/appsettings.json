{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "O"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "snapshot-writer-api",
    "Topics": {
      "snapshot-request": "ubs-advantage-snapshots",
      "snapshot-response": "ubs-advantage-snapshot-responses"
    },
    "ConsumeErrorBackoff": "00:00:05"
  },
  "BlobStorage": {
    "ServiceUri": "https://ubsplatformdevdata.blob.core.windows.net",
    "ConnectionString": "",
    "ContainerName": "ubsadvsnapshots"
  },
  "Database": {
    "ConnectionString": "Server=KAUSTUBH-PC;Database=platform-core-db-dev;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  }
}
